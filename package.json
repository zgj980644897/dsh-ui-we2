  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "theme",
    "skin",
    "sci-fi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgj980644897/dsh-ui-we2.git"
  },
  "homepage": "https://github.com/zgj980644897/dsh-ui-we2#readme",
  "bugs": {
    "url": "https://github.com/zgj980644897/dsh-ui-we2/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
